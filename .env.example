# Environment Variables
PUBLIC_BASE_URL=https://example.com
# App listen port (Docker Compose forces 3000 inside the container;
# local override uses host PORT from .env for 127.0.0.1:${PORT}:3000)
PORT=3000
VERSION=1.0.0
SECRET_KEY=change-me-to-a-long-random-string
SECRET_ADMIN_PHRASE=change-me-admin-phrase

# Public Access
# INDEX_PUBLIC: true = allow search-engine indexing; false = noindex (default)
INDEX_PUBLIC=false
# CV_REQUIRE_TOKEN: true = gate without ?k= (default); false = public CV (PII still token-only)
CV_REQUIRE_TOKEN=true


# Legal URLs
LEGAL_IMPRINT_URL=
LEGAL_PRIVACY_URL=

# API Keys
DEEPL_API_KEY=
MISTRAL_AI_API_KEY=
